#if AURORA_SNES_DEBUG_STATE

enum
{
    AURORA_SNDBG_VERSION = 1,
    AURORA_SNDBG_SECTION_COUNT = 6,
    AURORA_SNDBG_FLAG_ROM = 1u << 0,
    AURORA_SNDBG_FLAG_RAW_OBJECTS = 1u << 1,
    AURORA_SNDBG_FLAG_ASM_CONTEXT = 1u << 2,
    AURORA_SNDBG_FLAG_SOURCES = 1u << 3
};

struct AuroraSnesDebugHeaderT
{
    Uint8  Magic[8];              /* AURSDBG1 */
    Uint32 Version;
    Uint32 Endian;                /* 0x12345678 */
    Uint32 HeaderBytes;
    Uint32 SectionCount;
    Uint32 Flags;
    Uint32 RomImageCRC32;
    Uint32 RomRawCRC32;
    Uint32 RomBytes;
    Uint32 StateBytes;
    Uint32 SnesSystemBytes;
    Uint32 SnesRomObjectBytes;
    Uint32 Frame;
    Uint32 Line;
    Uint32 CpuPC;
    Uint32 SpcPC;
    Uint32 SourceBundleBytes;
    Uint32 Reserved[8];
    Char   RomPath[256];
};

struct AuroraSnesDebugSectionT
{
    Uint8  Tag[8];
    Uint32 Version;
    Uint32 Bytes;
    Uint32 CRC32;
    Uint32 Flags;
};

typedef char AuroraSnesDebugHeaderSizeCheck[
    sizeof(AuroraSnesDebugHeaderT) == 360 ? 1 : -1];
typedef char AuroraSnesDebugSectionSizeCheck[
    sizeof(AuroraSnesDebugSectionT) == 24 ? 1 : -1];

static Uint32 _AuroraSnesDebugCRC32(const Uint8 *pData, Uint32 nBytes)
{
    static Uint32 Table[256];
    static Bool bReady = FALSE;
    if (!bReady)
    {
        for (Uint32 i = 0; i < 256u; ++i)
        {
            Uint32 c = i;
            for (Uint32 bit = 0; bit < 8u; ++bit)
                c = (c >> 1) ^ ((c & 1u) ? 0xEDB88320u : 0u);
            Table[i] = c;
        }
        bReady = TRUE;
    }
    Uint32 crc = 0xFFFFFFFFu;
    while (nBytes--)
        crc = Table[(crc ^ *pData++) & 0xFFu] ^ (crc >> 8);
    return crc ^ 0xFFFFFFFFu;
}

static void _AuroraSnesDebugStatus(const char *pFormat, ...)
{
    va_list ap;
    va_start(ap, pFormat);
    vsnprintf(_MainLoop_StatusStr, sizeof(_MainLoop_StatusStr), pFormat, ap);
    va_end(ap);
    _MainLoop_StatusCount = 240;
}

static Bool _AuroraSnesDebugWriteAll(FILE *pFile, const void *pData, Uint32 nBytes)
{
    if (!nBytes) return TRUE;
    return fwrite(pData, 1, nBytes, pFile) == nBytes ? TRUE : FALSE;
}

static Bool _AuroraSnesDebugWriteSection(
    FILE *pFile, const char *pTag, const void *pData, Uint32 nBytes, Uint32 uFlags)
{
    AuroraSnesDebugSectionT s;
    memset(&s, 0, sizeof(s));
    strncpy((char *)s.Tag, pTag, sizeof(s.Tag));
    s.Version = 1;
    s.Bytes = nBytes;
    s.CRC32 = nBytes ? _AuroraSnesDebugCRC32((const Uint8 *)pData, nBytes) : 0u;
    s.Flags = uFlags;
    if (!_AuroraSnesDebugWriteAll(pFile, &s, sizeof(s))) return FALSE;
    return _AuroraSnesDebugWriteAll(pFile, pData, nBytes);
}

static void _AuroraSnesDebugAppend(
    Char *pOut, Uint32 nOutBytes, Uint32 *pPos, const char *pFormat, ...)
{
    if (*pPos >= nOutBytes) return;
    va_list ap;
    va_start(ap, pFormat);
    Int32 n = vsnprintf(pOut + *pPos, nOutBytes - *pPos, pFormat, ap);
    va_end(ap);
    if (n <= 0) return;
    Uint32 u = (Uint32)n;
    if (u >= nOutBytes - *pPos) *pPos = nOutBytes - 1u;
    else *pPos += u;
}

static Uint32 _AuroraSnesDebugBuildAsmContext(Char *pOut, Uint32 nOutBytes)
{
    Uint32 pos = 0;
    SNCpuT *pCpu = _pSnes ? _pSnes->GetCpu() : NULL;
    SNSpcT *pSpc = _pSnes ? _pSnes->GetSpc() : NULL;
    if (!pCpu || !pSpc || !pOut || nOutBytes < 2u) return 0;

    _AuroraSnesDebugAppend(pOut, nOutBytes, &pos,
        "SNESticleAurora SNES debug state v1\n"
        "ROM path: %s\n"
        "Frame: %u  Line: %u\n\n",
        _RomPath, (unsigned)_pSnes->GetFrame(),
        (unsigned)_pSnes->DebugGetLine());

    _AuroraSnesDebugAppend(pOut, nOutBytes, &pos,
        "[65816]\n"
        "PC=%06X A=%04X X=%04X Y=%04X S=%04X DP=%04X DB=%06X P=%02X E=%u\n"
        "Cycles=%d total=%d frame=%d line=%d abort=%d running=%d signal=%02X nmi_dma_delay=%u mdr=%02X\n",
        (unsigned)pCpu->Regs.rPC,
        (unsigned)pCpu->Regs.rA.w, (unsigned)pCpu->Regs.rX.w,
        (unsigned)pCpu->Regs.rY.w, (unsigned)pCpu->Regs.rS.w,
        (unsigned)pCpu->Regs.rDP, (unsigned)pCpu->Regs.rDB,
        (unsigned)pCpu->Regs.rP, (unsigned)pCpu->Regs.rE,
        (int)pCpu->Cycles,
        (int)pCpu->Counter[SNCPU_COUNTER_TOTAL],
        (int)pCpu->Counter[SNCPU_COUNTER_FRAME],
        (int)pCpu->Counter[SNCPU_COUNTER_LINE],
        (int)pCpu->nAbortCycles, (int)pCpu->bRunning,
        (unsigned)pCpu->uSignal, (unsigned)pCpu->uNmiDmaDelay,
        (unsigned)pCpu->uMDR);

    Uint32 pc = pCpu->Regs.rPC & 0xFFFFFFu;
    Uint8 flags = pCpu->Regs.rP;
    for (Int32 i = 0; i < 40; ++i)
    {
        Uint8 op[4] = {0,0,0,0};
        Char dis[128];
        SNCPUPeekMem(pCpu, pc, op, sizeof(op));
        Int32 n = SNDisasm(dis, op, pc, &flags);
        if (n <= 0 || n > 4) n = 1;
        _AuroraSnesDebugAppend(pOut, nOutBytes, &pos,
            "%06X  %02X %02X %02X %02X  %s\n",
            (unsigned)pc, (unsigned)op[0], (unsigned)op[1],
            (unsigned)op[2], (unsigned)op[3], dis);
        pc = (pc & 0xFF0000u) | ((pc + (Uint32)n) & 0xFFFFu);
    }

    _AuroraSnesDebugAppend(pOut, nOutBytes, &pos,
        "\n[SPC700]\n"
        "PC=%04X A=%02X X=%02X Y=%02X SP=%02X PSW=%02X HALT=%02X\n"
        "Cycles=%d total=%d frame=%d rom_enable=%d\n",
        (unsigned)pSpc->Regs.rPC, (unsigned)pSpc->Regs.rA,
        (unsigned)pSpc->Regs.rX, (unsigned)pSpc->Regs.rY,
        (unsigned)pSpc->Regs.rSP, (unsigned)pSpc->Regs.rPSW,
        (unsigned)pSpc->Regs.uPad, (int)pSpc->Cycles,
        (int)pSpc->Counter[SNSPC_COUNTER_TOTAL],
        (int)pSpc->Counter[SNSPC_COUNTER_FRAME],
        (int)pSpc->bRomEnable);

    Uint32 spcpc = pSpc->Regs.rPC;
    for (Int32 i = 0; i < 64; ++i)
    {
        Uint8 op[4] = {0,0,0,0};
        Char dis[128];
        SNSPCPeekMem(pSpc, spcpc, op, sizeof(op));
        Int32 n = SNSPCDisasm(dis, op, spcpc);
        if (n <= 0 || n > 4) n = 1;
        _AuroraSnesDebugAppend(pOut, nOutBytes, &pos,
            "%04X  %02X %02X %02X %02X  %s\n",
            (unsigned)spcpc, (unsigned)op[0], (unsigned)op[1],
            (unsigned)op[2], (unsigned)op[3], dis);
        spcpc = (spcpc + (Uint32)n) & 0xFFFFu;
    }

    if (pos >= nOutBytes) pos = nOutBytes - 1u;
    pOut[pos] = 0;
    return pos + 1u;
}

Bool MainLoopSaveSnesDebugState(void)
{
    if (!_pSnes || !_pSnesRom || _pSystem != _pSnes || !_pSnesRom->IsLoaded())
    {
        _AuroraSnesDebugStatus("Debug state: load a SNES game first.");
        return FALSE;
    }

    const Uint8 *pRom = _pSnesRom->GetData();
    const Uint32 nRom = _pSnesRom->GetBytes();
    if (!pRom || !nRom)
    {
        _AuroraSnesDebugStatus("Debug state: ROM image unavailable.");
        return FALSE;
    }

    const Uint32 uRomCRC = _AuroraSnesDebugCRC32(pRom, nRom);
    const Int32 iStateBytes = _pSnes->GetStateSize();
    if (iStateBytes <= 0)
    {
        _AuroraSnesDebugStatus("Debug state: core state serializer unavailable.");
        return FALSE;
    }

    Uint8 *pState = (Uint8 *)malloc((size_t)iStateBytes);
    if (!pState)
    {
        _AuroraSnesDebugStatus("Debug state: not enough EE RAM for state scratch.");
        return FALSE;
    }
    memset(pState, 0, (size_t)iStateBytes);
    if (!_pSnes->SaveStateChecked(pState, iStateBytes))
    {
        free(pState);
        _AuroraSnesDebugStatus("Debug state: core state capture refused.");
        return FALSE;
    }

    Char asmContext[16384];
    const Uint32 nAsm = _AuroraSnesDebugBuildAsmContext(
        asmContext, (Uint32)sizeof(asmContext));

    AuroraSnesDebugHeaderT h;
    memset(&h, 0, sizeof(h));
    memcpy(h.Magic, "AURSDBG1", 8);
    h.Version = AURORA_SNDBG_VERSION;
    h.Endian = 0x12345678u;
    h.HeaderBytes = sizeof(h);
    h.SectionCount = AURORA_SNDBG_SECTION_COUNT;
    h.Flags = AURORA_SNDBG_FLAG_ROM |
              AURORA_SNDBG_FLAG_RAW_OBJECTS |
              AURORA_SNDBG_FLAG_ASM_CONTEXT |
              AURORA_SNDBG_FLAG_SOURCES;
    h.RomImageCRC32 = uRomCRC;
    h.RomRawCRC32 = _pSnesRom->GetRawFileCRC32();
    h.RomBytes = nRom;
    h.StateBytes = (Uint32)iStateBytes;
    h.SnesSystemBytes = (Uint32)sizeof(SnesSystem);
    h.SnesRomObjectBytes = (Uint32)sizeof(SnesRom);
    h.Frame = _pSnes->GetFrame();
    h.Line = _pSnes->DebugGetLine();
    h.CpuPC = _pSnes->GetCpu()->Regs.rPC & 0xFFFFFFu;
    h.SpcPC = _pSnes->GetSpc()->Regs.rPC;
    h.SourceBundleBytes = (Uint32)size_snes_debug_sources;
    strncpy(h.RomPath, _RomPath, sizeof(h.RomPath) - 1u);

    Char path[160];
    snprintf(path, sizeof(path),
             "mass0:/SNESticle/debug_%08X_F%08X.sndbg",
             (unsigned)uRomCRC, (unsigned)h.Frame);

    BgmIOBegin();
    FILE *pFile = fopen(path, "wb");
    if (!pFile)
    {
        snprintf(path, sizeof(path),
                 "mass0:/SNESDBG_%08X_F%08X.sndbg",
                 (unsigned)uRomCRC, (unsigned)h.Frame);
        pFile = fopen(path, "wb");
    }

    Bool ok = pFile ? TRUE : FALSE;
    if (ok) ok = _AuroraSnesDebugWriteAll(pFile, &h, sizeof(h));
    if (ok) ok = _AuroraSnesDebugWriteSection(
        pFile, "STATE", pState, (Uint32)iStateBytes, 0);
    if (ok) ok = _AuroraSnesDebugWriteSection(
        pFile, "ROMIMG", pRom, nRom, 0);
    if (ok) ok = _AuroraSnesDebugWriteSection(
        pFile, "RAWSYS", _pSnes, (Uint32)sizeof(SnesSystem), 1u);
    if (ok) ok = _AuroraSnesDebugWriteSection(
        pFile, "RAWROM", _pSnesRom, (Uint32)sizeof(SnesRom), 1u);
    if (ok) ok = _AuroraSnesDebugWriteSection(
        pFile, "ASMCTX", asmContext, nAsm, 2u);
    if (ok) ok = _AuroraSnesDebugWriteSection(
        pFile, "SOURCES", snes_debug_sources,
        (Uint32)size_snes_debug_sources, 3u);

    if (pFile)
    {
        if (fflush(pFile) != 0) ok = FALSE;
        if (fclose(pFile) != 0) ok = FALSE;
    }
    BgmIOEnd();
    free(pState);

    if (!ok)
    {
        remove(path);
        _AuroraSnesDebugStatus("Debug state: write failed; partial file removed.");
        return FALSE;
    }

    _AuroraSnesDebugStatus("Debug state saved: %s", path);
    return TRUE;
}

#endif /* AURORA_SNES_DEBUG_STATE */
