 * Self-contained SNES laboratory snapshot.
 *
 * Important design rule: this file is not even part of SRCS when
 * AURORA_SNES_DEBUG_STATE=0. There are no gameplay hot-path probes.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>

#include "types.h"
#include "snes.h"
